{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug PAAC with Gowalla",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/PAAC_main.py",
            "args": [
                "--dataset_name", "gowalla",
                "--layers_list", "[6]",
                "--cl_rate_list", "[5]", 
                "--align_reg_list", "[50]",
                "--lambada_list", "[0.2]",
                "--gama_list", "[0.2]",
                "--device", "0",
                "--batch_size", "2048",
                "--lr", "0.001",
                "--decay", "0.0001",
                "--emb_size", "64",
                "--num_epoch", "1000",
                "--EarlyStop", "10",
                "--topks", "[20]",
                "--seed", "12345"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Debug PAAC with Custom Args",
            "type": "python", 
            "request": "launch",
            "program": "${workspaceFolder}/PAAC_main.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}